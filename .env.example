# BackHaul AI - Environment Configuration
# Add your Google Gemini API key below:
GEMINI_API_KEY=
PORT=8080

# --- Optional: Face Login (all optional; app works without them) ---
# Path to a Firebase service-account JSON (needed to sign users in by face). Keep it secret, never commit it.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Alternative: whole service-account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=curiolab-5c4cf
# Secret used to encrypt stored face templates (REQUIRED when NODE_ENV=production)
FACE_ENC_KEY=
# Euclidean distance threshold, lower = stricter (default 0.5)
FACE_MATCH_THRESHOLD=0.5
# Demo mode is on by default outside production; set to false to disable
FACE_DEMO_MODE=true
